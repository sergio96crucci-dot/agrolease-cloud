rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════
//  Reglas de seguridad de AgroLease Tracker
//
//  Solo se puede leer y escribir con una sesión iniciada. Como en la app no
//  hay registro público, los únicos usuarios que existen son los que se crean
//  a mano en la consola de Firebase (Authentication → Usuarios).
//
//  Para publicar:
//    firebase deploy --only firestore:rules
// ══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // Lotes: nombres de productores y propietarios, superficies y notas.
    // Datos personales de terceros: nunca deben quedar accesibles sin sesión.
    match /lotes/{loteId} {
      allow read, write: if request.auth != null;
    }

    // Todo lo demás queda cerrado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
